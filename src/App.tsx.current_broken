                                                      {/* 발신인 및 시간 */}
                                                      <div className="flex items-center gap-1.5 mb-1 text-[10px] text-slate-500 font-bold">
                                                          <span>{isBot ? 'AI 관제 봇' : '사용자'}</span>
                                                          <span>·</span>
                                                          <span>{msg.timestamp}</span>
                                                      </div>
                                                      {/* 내용 말풍선 */}
                                                      <div className={`rounded-2xl p-3.5 text-xs shadow-md border ${
                                                          !isBot 
                                                              ? 'bg-indigo-600/90 border-indigo-500 text-white rounded-tr-none'
                                                              : isWelcome
                                                                  ? 'bg-slate-900 border-slate-800 text-slate-300 rounded-tl-none leading-relaxed whitespace-pre-wrap'
                                                                  : msg.status === 'completed'
                                                                      ? 'bg-slate-900 border-emerald-500/40 text-slate-300 rounded-tl-none w-full'
                                                                      : msg.status === 'error'
                                                                          ? 'bg-rose-950/20 border-rose-900/60 text-rose-300 rounded-tl-none'
                                                                          : 'bg-slate-900 border-slate-800 text-indigo-300 rounded-tl-none animate-pulse flex items-center gap-2'
                                                      }`}>
                                                          {/* 봇 진행 중인 상태 */}
                                                          {isBot && msg.status && msg.status !== 'completed' && msg.status !== 'error' && (
                                                              <div className="flex items-center gap-2.5 font-bold">
                                                                  <RefreshCw className="w-3.5 h-3.5 animate-spin text-indigo-400" />
                                                                  <span>{msg.text}</span>
                                                              </div>
                                                          )}
                                                          {/* 일반 텍스트 출력 (웰컴이나 사용자 메시지, 혹은 에러) */}
                                                          {(!msg.status || msg.status === 'error' || isWelcome) && (
                                                              <div className="whitespace-pre-wrap leading-relaxed">
                                                                  {msg.text}
                                                              </div>
                                                          )}
                                                          {/* 사용자 메시지에 포함된 첨부 이미지들 */}
                                                          {!isBot && msg.images && msg.images.length > 0 && (
                                                              <div className="mt-2.5 grid grid-cols-1 gap-2">
                                                                  {msg.images.map((img, i) => (
                                                                      <img 
                                                                          key={i} 
                                                                          src={img} 
                                                                          alt="pasted_capture" 
                                                                          className="max-h-36 rounded-lg object-contain border border-indigo-400/30" 
                                                                      />
                                                                  ))}
                                                              </div>
                                                          )}
                                                          {/* 완료 상태의 Adaptive Card 형태 보고서 카드 */}
                                                          {isBot && msg.status === 'completed' && (
                                                              <div className="space-y-4">
                                                                  <div className="border-b border-slate-800 pb-2.5 flex items-center justify-between">
                                                                      <span className="font-extrabold text-emerald-400 text-sm flex items-center gap-1.5">
                                                                          ✨ Teams 오케스트레이션 분석 완료
                                                                      </span>
                                                                      <span className="text-[9px] font-mono bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded">
                                                                          통합 리포트 발행
                                                                      </span>
                                                                  </div>
                                                                  {/* 배정 정보 */}
                                                                  {msg.resultData?.plan?.assignments && (
                                                                      <div className="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800 text-[11px] space-y-1.5">
                                                                          <div className="font-extrabold text-slate-400">👔 팀장 자동 인력 배정 계획:</div>
                                                                          {msg.resultData.plan.assignments.map((a: any, i: number) => (
                                                                              <div key={i} className="text-slate-300 flex items-center gap-1">
                                                                                  <span className="text-emerald-400 font-bold">✓</span>
                                                                                  <span><strong>{a.agent_name}</strong> → {a.projects?.join(', ')}</span>
                                                                              </div>
                                                                          ))}
                                                                      </div>
                                                                  )}
                                                                  {/* 본문 메시지 */}
                                                                  <div className="text-slate-300 whitespace-pre-wrap leading-relaxed max-h-[300px] overflow-y-auto pr-1 text-[11.5px] font-medium custom-scrollbar border border-slate-800/40 p-2.5 rounded-lg bg-slate-950/20">
                                                                      {msg.text.replace('### 👔 팀장 자동 배정 분석 완료\n\n', '').replace('### 👔 팀장 자동 배정 분석 완료\n\n', '')}
                                                                  </div>
                                                                  
                                                                  <div className="text-[10px] text-slate-500 font-semibold italic text-right">
                                                                      * 전체 리포트와 비주얼 흐름도는 중앙 화면의 뷰어에 동기화되었습니다.
                                                                  </div>
                                                              </div>
                                                          )}
                                                      </div>
                                                  </div>
                                              </div>
                                          );
                                      })}
                                  </div>
                                  {/* 첨부된 이미지 미리보기 (채팅 전송 전 대기열) */}
                                  {attachedImages.length > 0 && (
                                      <div className="bg-slate-900 border-x border-slate-850 p-3 flex gap-3.5 overflow-x-auto custom-scrollbar">
                                          {attachedImages.map((img, idx) => (
                                              <div key={idx} className="relative w-16 h-16 border border-indigo-500/30 rounded-lg overflow-hidden bg-slate-950 flex-shrink-0 flex items-center justify-center">
                                                  <img src={img} alt="attached" className="w-full h-full object-cover" />
                                                  <button 
                                                      onClick={() => setAttachedImages(prev => prev.filter((_, i) => i !== idx))} 
                                                      className="absolute top-0.5 right-0.5 bg-rose-600/90 text-white rounded-full p-0.5 text-[8px] hover:bg-rose-500 transition-colors w-4 h-4 flex items-center justify-center shadow-md font-black"
                                                  >
                                                      ✕
                                                  </button>
                                              </div>
                                          ))}
                                      </div>
                                  )}
                                  {/* Teams 채팅 입력창 */}
                                  <div className="bg-slate-900 border-x border-b border-slate-800 rounded-b-xl p-3 flex gap-2">
                                      <input
                                          type="text"
                                          value={teamsInput}
                                          onChange={(e) => setTeamsInput(e.target.value)}
                                          onKeyDown={(e) => {
                                              if (e.key === 'Enter' && !e.shiftKey) {
                                                  e.preventDefault();
                                                  handleSendTeamsMessage();
                                              }
                                          }}
                                          disabled={isAnalyzing}
                                          placeholder={isAnalyzing ? "분석이 진행되는 동안 대기해주세요..." : "@AI GRIT-2309522 내용분석해줘 (Ctrl+V로 캡처 추가)"}
                                          className="flex-1 bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 placeholder-slate-500 outline-none focus:border-indigo-500 transition-all font-medium disabled:opacity-50"
                                      />
                                      <button
                                          onClick={handleSendTeamsMessage}
                                          disabled={isAnalyzing || (!teamsInput.trim() && attachedImages.length === 0)}
                                          className="bg-indigo-600 hover:bg-indigo-500 disabled:opacity-30 disabled:hover:bg-indigo-600 text-white px-4 py-2 rounded-lg font-black text-xs transition-colors flex items-center justify-center gap-1.5 shadow active:scale-95"
                                      >
                                          전송
                                      </button>
                                  </div>
                              </div>
                          )}
                      </div>
                  </div>
              </div>
      );
  }
  export default function App() {
      return (
          <AgentsProvider>
              <Dashboard />
          </AgentsProvider>
      );
  }
